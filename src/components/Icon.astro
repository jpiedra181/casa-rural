---
/** Iconos de línea (24×24, trazo actual). Decorativos: siempre aria-hidden. */
interface Props {
  name: 'arrow-right' | 'arrow-down' | 'arrow-up-right' | '360' | 'plus' | 'minus' | 'expand' | 'close' | 'check' | 'drag';
  size?: number;
  class?: string;
}
const { name, size = 18, class: className } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'arrow-right' && <path d="M4 12h15M13.5 6.5 19 12l-5.5 5.5" />}
  {name === 'arrow-down' && <path d="M12 4v15M6.5 13.5 12 19l5.5-5.5" />}
  {name === 'arrow-up-right' && <path d="M7 17 17 7M8.5 7H17v8.5" />}
  {name === '360' && (
    <>
      <ellipse cx="12" cy="12" rx="4" ry="9.25" opacity="0.5" />
      <path d="M7.2 15.7C4 15 2 13.6 2 12c0-2.3 4.5-4.1 10-4.1S22 9.7 22 12c0 1.9-3.1 3.5-7.4 3.9" />
      <path d="m12.8 13.8 2 2.1-2.1 2" />
    </>
  )}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'minus' && <path d="M5 12h14" />}
  {name === 'expand' && <path d="M9 4H4v5M15 4h5v5M9 20H4v-5M15 20h5v-5" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'check' && <path d="m5 12.5 4.2 4.2L19 7" />}
  {name === 'drag' && <path d="M8 8.5 4.5 12 8 15.5M16 8.5l3.5 3.5-3.5 3.5M4.5 12h15" />}
</svg>
