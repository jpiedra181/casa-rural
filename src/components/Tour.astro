---
/**
 * Visita virtual 360° en un <dialog>. El visor (Pannellum, MIT, en /public/vendor)
 * y las panorámicas solo se descargan al abrirlo.
 * Cualquier elemento con [data-tour-open] lo abre.
 */
import Icon from './Icon.astro';
import { useT, type Lang } from '../i18n/ui';
import { site } from '../data/site';
interface Props { lang: Lang }
const t = useT(Astro.props.lang);
const tr = t.tour;

// yaw/pitch en grados. Los puntos de salto van en el suelo, hacia donde está cada estancia.
const scenes = [
  {
    id: 'salon', title: tr.scenes.salon, src: '/tour/salon.jpg', preview: '/tour/salon-preview.jpg', yaw: 8, pitch: -4,
    links: [
      { to: 'dormitorio', label: tr.links.dormitorio, yaw: -24, pitch: -27 },
      { to: 'pinar', label: tr.links.pinar, yaw: 124, pitch: -16 },
    ],
  },
  {
    id: 'dormitorio', title: tr.scenes.dormitorio, src: '/tour/dormitorio.jpg', preview: '/tour/dormitorio-preview.jpg', yaw: -26, pitch: -6,
    links: [
      { to: 'salon', label: tr.links.salon, yaw: 122, pitch: -24 },
      { to: 'pinar', label: tr.links.pinar, yaw: 36, pitch: -34 },
    ],
  },
  {
    id: 'pinar', title: tr.scenes.pinar, src: '/tour/pinar.jpg', preview: '/tour/pinar-preview.jpg', yaw: 0, pitch: 4,
    links: [{ to: 'salon', label: tr.links.salon, yaw: -32, pitch: -22 }],
  },
];
---

<dialog class="tour" aria-labelledby="tour-title" data-tour={JSON.stringify({ scenes })} data-loading={tr.loading} data-error={tr.error}>
  <div class="tour__shell">
    <div class="tour__stage" data-tour-stage>
      <div class="tour__pano" data-tour-pano role="application" aria-roledescription="360°" aria-label={tr.viewerLabel} tabindex="0" autofocus></div>

      <div class="tour__veil" data-tour-veil data-state="loading" aria-live="polite">
        <span class="tour__spinner" aria-hidden="true"></span>
        <p data-tour-veil-text>{tr.loading}</p>
      </div>

      <p class="tour__badge"><span class="tour__badge-dot" aria-hidden="true"></span>{tr.sample}</p>

      <p class="tour__hint" data-tour-hint aria-hidden="true"><Icon name="drag" size={20} />{tr.hint}</p>

      <div class="tour__tools">
        <button type="button" class="tour__tool" data-tour-zoom="-15" aria-label={tr.zoomIn}><Icon name="plus" /></button>
        <button type="button" class="tour__tool" data-tour-zoom="15" aria-label={tr.zoomOut}><Icon name="minus" /></button>
        <button type="button" class="tour__tool" data-tour-fs aria-label={tr.fullscreen}><Icon name="expand" /></button>
      </div>

      <div class="tour__scenes" role="group" aria-label={tr.scenesLabel}>
        {scenes.map((s, i) => (
          <button type="button" class="tour__scene" data-scene={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            <img src={s.preview} alt="" width="56" height="36" loading="lazy" decoding="async" />
            <span>{s.title}</span>
          </button>
        ))}
      </div>
    </div>

    <aside class="tour__panel">
      <div class="tour__intro">
        <p class="label">{tr.label}</p>
        <h2 id="tour-title" class="tour__title serif">{tr.titleA} <em>{tr.titleEm}</em></h2>
        <p class="muted">{tr.intro}</p>
      </div>

      <section class="offer" aria-labelledby="offer-title">
        <p class="offer__tag"><span aria-hidden="true">✦</span> {tr.offer.tag} · {site.author.name}</p>
        <h3 id="offer-title" class="offer__title serif">{tr.offer.title}</h3>
        <p class="offer__text muted">{tr.offer.text}</p>
        <ul role="list" class="offer__list">
          {tr.offer.items.map((item) => <li><Icon name="check" size={18} />{item}</li>)}
        </ul>
        <a class="btn btn--primary btn--block" href={site.author.url} target="_blank" rel="noopener">{tr.offer.cta}<Icon name="arrow-up-right" class="btn__icon btn__icon--right" /></a>
        <p class="offer__more">{tr.offer.moreA} <a class="link-accent" href="https://artgallery360.art/" target="_blank" rel="noopener">{tr.offer.moreB} ↗</a></p>
      </section>

      <p class="tour__credit">{tr.credit}</p>
    </aside>

    <button type="button" class="tour__close" data-tour-close aria-label={tr.close}><Icon name="close" size={22} /></button>
  </div>
</dialog>

<script>
  import '../scripts/tour.ts';
</script>

<style is:global>
  html:has(.tour[open]) { overflow: hidden; }

  .tour {
    width: min(80rem, 100vw - 3rem);
    height: min(50rem, 100dvh - 3rem);
    max-width: none; max-height: none;
    padding: 0; border: 0; background: transparent; color: var(--text);
    overflow: visible;
    opacity: 0; transform: translateY(1.125rem) scale(0.98);
    transition:
      opacity 0.4s ease,
      transform 0.6s var(--ease-out),
      overlay 0.4s allow-discrete,
      display 0.4s allow-discrete;
  }
  .tour[open] { opacity: 1; transform: none; }
  @starting-style { .tour[open] { opacity: 0; transform: translateY(1.125rem) scale(0.98); } }
  .tour::backdrop {
    background: rgb(8 6 4 / 0);
    transition: background-color 0.4s, backdrop-filter 0.4s, overlay 0.4s allow-discrete, display 0.4s allow-discrete;
  }
  .tour[open]::backdrop { background: rgb(8 6 4 / 0.78); backdrop-filter: blur(0.5rem); }
  @starting-style { .tour[open]::backdrop { background: rgb(8 6 4 / 0); backdrop-filter: blur(0); } }

  .tour__shell {
    position: relative;
    display: grid; grid-template-columns: minmax(0, 1fr) 25.625rem;
    height: 100%;
    border-radius: 0.375rem; overflow: hidden;
    background: var(--surface);
    border: 1px solid rgb(var(--ember) / 0.25);
    box-shadow: 0 2.5rem 7.5rem rgb(0 0 0 / 0.6), 0 0 5.625rem rgb(var(--ember) / 0.12);
  }

  /* ---------- Visor ---------- */
  .tour__stage { position: relative; min-height: 0; background: #0b0907; overflow: hidden; }
  .tour__pano { position: absolute; inset: 0; }
  .tour__pano:focus-visible { outline: 2px solid var(--accent); outline-offset: -4px; }
  .tour .pnlm-container { background: #0b0907; font-family: var(--sans); }
  .tour .pnlm-load-box, .tour .pnlm-about-msg, .tour .pnlm-panorama-info { display: none !important; }

  .tour__veil {
    position: absolute; inset: 0; z-index: 3;
    display: grid; place-content: center; justify-items: center; gap: 1.125rem;
    background: radial-gradient(60% 60% at 50% 50%, rgb(21 17 14 / 0.5), rgb(11 9 7 / 0.85));
    font-size: 0.9375rem; color: var(--muted);
    transition: opacity 0.7s ease, visibility 0.7s;
  }
  .tour__veil[data-state='ready'] { opacity: 0; visibility: hidden; }
  .tour__veil[data-state='error'] .tour__spinner { display: none; }
  .tour__spinner {
    width: 3.375rem; aspect-ratio: 1; border-radius: 50%;
    background: conic-gradient(from 0deg, transparent 0 20%, rgb(var(--ember)) 70%, #ffd7a8);
    -webkit-mask: radial-gradient(circle, transparent 58%, #000 60%);
    mask: radial-gradient(circle, transparent 58%, #000 60%);
    filter: drop-shadow(0 0 0.625rem rgb(var(--ember) / 0.8));
    animation: tour-spin 1s linear infinite;
  }
  @keyframes tour-spin { to { transform: rotate(360deg); } }

  .tour__badge, .tour__hint, .tour__scenes, .tour__tool {
    background: rgb(21 17 14 / 0.62);
    -webkit-backdrop-filter: blur(0.625rem) saturate(1.3);
    backdrop-filter: blur(0.625rem) saturate(1.3);
    border: 1px solid rgb(var(--gold) / 0.2);
  }
  .tour__badge {
    position: absolute; top: 1rem; left: 1rem; z-index: 2;
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.4375rem 0.875rem 0.4375rem 0.75rem; border-radius: var(--pill);
    font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
  }
  .tour__badge-dot { width: 0.4375rem; height: 0.4375rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0.625rem 2px rgb(var(--ember) / 0.9); animation: flicker 2.4s ease-in-out infinite; }

  .tour__hint {
    position: absolute; left: 50%; top: 50%; z-index: 2;
    display: inline-flex; align-items: center; gap: 0.625rem;
    padding: 0.75rem 1.25rem; border-radius: var(--pill);
    font-size: 0.875rem; font-weight: 600; white-space: nowrap;
    transform: translate(-50%, -50%);
    opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity 0.6s ease, visibility 0.6s;
  }
  .tour__hint.is-on { opacity: 1; visibility: visible; }
  .tour__hint svg { animation: sway 1.8s ease-in-out infinite; color: var(--accent); }
  @keyframes sway { 50% { transform: translateX(0.375rem); } }

  .tour__tools { position: absolute; top: 1rem; right: 1rem; z-index: 2; display: grid; gap: 0.5rem; }
  .tour__tool {
    display: grid; place-items: center; width: 2.625rem; height: 2.625rem; border-radius: 50%;
    color: var(--text); cursor: pointer;
    transition: transform 0.4s var(--ease-out), background-color 0.3s, color 0.3s, border-color 0.3s;
  }
  .tour__tool:hover { transform: scale(1.08); background: var(--primary); color: var(--on-primary); border-color: var(--primary); }

  .tour__scenes {
    position: absolute; left: 1rem; right: 1rem; bottom: 1.125rem; z-index: 2;
    width: max-content; max-width: calc(100% - 2rem); margin-inline: auto;
    display: flex; gap: 0.375rem; padding: 0.375rem; border-radius: var(--pill);
    overflow-x: auto; scrollbar-width: none;
  }
  .tour__scene {
    display: inline-flex; align-items: center; gap: 0.625rem; flex-shrink: 0;
    padding: 0.25rem 1rem 0.25rem 0.25rem; border-radius: var(--pill);
    border: 1px solid transparent; background: transparent; color: var(--muted);
    font-size: 0.8125rem; font-weight: 600; white-space: nowrap; cursor: pointer;
    transition: color 0.3s, background-color 0.3s, border-color 0.3s, box-shadow 0.4s;
  }
  .tour__scene img { width: 2.75rem; height: 1.875rem; object-fit: cover; border-radius: var(--pill); opacity: 0.75; transition: opacity 0.3s; }
  .tour__scene:hover { color: var(--text); background: rgb(255 255 255 / 0.06); }
  .tour__scene[aria-pressed='true'] {
    color: var(--text); background: rgb(var(--ember) / 0.16); border-color: rgb(var(--ember) / 0.6);
    box-shadow: 0 0 1.375rem rgb(var(--ember) / 0.35);
  }
  .tour__scene[aria-pressed='true'] img, .tour__scene:hover img { opacity: 1; }

  /* Puntos de salto (los crea Pannellum dentro del visor) */
  .tour .hs { width: 2.875rem; height: 2.875rem; cursor: pointer; }
  .hs__dot {
    position: absolute; inset: 0; border-radius: 50%;
    background:
      radial-gradient(circle, #fff3df 0 16%, transparent 17%),
      radial-gradient(circle, rgb(var(--ember)) 0 34%, rgb(var(--ember) / 0.28) 35% 100%);
    box-shadow: 0 0 1.5rem rgb(var(--ember) / 0.8);
    transition: transform 0.5s var(--ease-out);
  }
  .hs__dot::after {
    content: ''; position: absolute; inset: 0; border-radius: 50%;
    border: 2px solid rgb(var(--gold) / 0.9);
    animation: hs-ping 2.2s var(--ease-out) infinite;
  }
  @keyframes hs-ping { from { transform: scale(0.6); opacity: 1; } to { transform: scale(1.8); opacity: 0; } }
  .hs__label {
    position: absolute; left: 50%; bottom: calc(100% + 0.625rem);
    transform: translateX(-50%);
    padding: 0.4375rem 0.875rem; border-radius: var(--pill); white-space: nowrap;
    background: rgb(21 17 14 / 0.78); border: 1px solid rgb(var(--gold) / 0.25);
    -webkit-backdrop-filter: blur(0.5rem); backdrop-filter: blur(0.5rem);
    font-size: 0.8125rem; font-weight: 600; color: var(--text);
    transition: transform 0.5s var(--ease-out), background-color 0.3s, color 0.3s;
  }
  .tour .hs:is(:hover, :focus-visible) .hs__dot { transform: scale(1.15); }
  .tour .hs:is(:hover, :focus-visible) .hs__label { transform: translateX(-50%) translateY(-3px); background: var(--primary); color: var(--on-primary); }
  .tour .hs:focus-visible { outline: none; }

  /* ---------- Panel ---------- */
  .tour__panel {
    display: flex; flex-direction: column; gap: 1.375rem;
    padding: 2.25rem 2rem 1.375rem; overflow-y: auto;
    background: linear-gradient(180deg, var(--surface), #18130f);
    border-left: 1px solid var(--line);
  }
  .tour__intro { display: grid; gap: 0.75rem; padding-right: 2.5rem; }
  .tour__title { font-size: clamp(2rem, 1.6rem + 1vw, 2.5rem); line-height: 1.02; }
  .tour__title em { font-style: italic; color: var(--accent); }
  .tour__intro .muted { font-size: 0.875rem; }

  .offer {
    position: relative; display: grid; gap: 0.75rem;
    padding: 1.375rem 1.375rem 1.125rem; border-radius: 0.375rem;
    background:
      radial-gradient(90% 70% at 100% 0%, rgb(var(--ember) / 0.2), transparent 70%),
      rgb(14 11 9 / 0.55);
    border: 1px solid rgb(var(--ember) / 0.38);
    margin-top: auto;
  }
  .offer__tag {
    justify-self: start;
    display: inline-flex; gap: 0.375rem; align-items: center;
    padding: 0.3125rem 0.75rem; border-radius: var(--pill);
    background: rgb(var(--ember) / 0.16); color: var(--accent);
    font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
  }
  .offer__title { font-size: 1.5rem; line-height: 1.1; }
  .offer__text { font-size: 0.8125rem; }
  .offer__list { display: grid; gap: 0.375rem; margin: 0 0 0.25rem; padding: 0; list-style: none; font-size: 0.8125rem; }
  .offer__list li { display: flex; gap: 0.625rem; align-items: flex-start; }
  .offer__list svg { color: var(--accent); flex-shrink: 0; margin-top: 1px; }
  .offer__more { font-size: 0.8125rem; color: var(--muted); text-align: center; }
  .tour__credit { font-size: 0.6875rem; color: var(--muted); opacity: 0.7; }

  .tour__close {
    position: absolute; top: 0.875rem; right: 0.875rem; z-index: 5;
    display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%;
    background: rgb(21 17 14 / 0.7); border: 1px solid var(--line); color: var(--text); cursor: pointer;
    transition: transform 0.5s var(--ease-out), background-color 0.3s, color 0.3s, border-color 0.3s;
  }
  .tour__close:hover { transform: rotate(90deg); background: var(--primary); color: var(--on-primary); border-color: var(--primary); }

  /* Pantalla completa del visor (con los controles propios dentro) */
  .tour__stage:fullscreen { width: 100vw; height: 100vh; }

  @media (max-width: 860px) {
    .tour { width: 100vw; height: 100dvh; transform: translateY(1.5rem); }
    .tour__shell { grid-template-columns: 1fr; grid-template-rows: 58dvh auto; overflow-y: auto; border-radius: 0; border: 0; }
    .tour__panel { overflow: visible; border-left: 0; border-top: 1px solid var(--line); padding: 1.75rem 1.25rem 2rem; gap: 1.5rem; }
    .tour__intro { padding-right: 0; }
    .offer { margin-top: 0; }
    .tour__close { position: fixed; }
    .tour__tools { top: 4.25rem; right: 0.875rem; }
    .tour__tool { width: 2.5rem; height: 2.5rem; }
    .tour__scene { padding-right: 0.75rem; }
    .tour__scene img { display: none; }
    .tour__scene { padding: 0.5rem 0.875rem; }
  }
  /* Móviles estrechos: las tres estancias caben sin desplazar */
  @media (max-width: 400px) {
    .tour__scene { padding: 0.5rem 0.625rem; font-size: 0.75rem; }
  }
  /* Móviles en horizontal: visor a toda altura y panel al lado con su propio scroll */
  @media (max-width: 980px) and (max-height: 560px) and (orientation: landscape) {
    .tour { width: 100vw; height: 100dvh; }
    .tour__shell { grid-template-columns: minmax(0, 1fr) min(20rem, 40vw); grid-template-rows: 100%; overflow: hidden; border-radius: 0; border: 0; }
    .tour__panel { overflow-y: auto; border-top: 0; border-left: 1px solid var(--line); padding: 1rem 1rem 1.25rem; gap: 1rem; }
    .tour__intro { padding-right: 2.75rem; }
    .tour__title { font-size: 1.5rem; }
    .tour__intro .muted { font-size: 0.8125rem; }
    .tour__close { position: absolute; top: 0.625rem; right: 0.625rem; width: 2.5rem; height: 2.5rem; }
    .tour__tools { top: 0.75rem; right: 0.75rem; grid-auto-flow: column; }
    .tour__badge { top: 0.75rem; left: 0.75rem; }
    .tour__scenes { bottom: 0.75rem; }
    .tour__scene img { display: none; }
    .tour__scene { padding: 0.5rem 0.75rem; }
    .offer { padding: 1rem; gap: 0.625rem; }
    .offer__title { font-size: 1.25rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hs__dot::after, .tour__hint svg { animation: none; }
  }
</style>
