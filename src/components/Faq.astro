---
import { useT, type Lang } from '../i18n/ui';
import { site } from '../data/site';
interface Props { lang: Lang }
const t = useT(Astro.props.lang);
const q = t.faq;
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(t.form.waTextNoDates)}`;
---

<section id="preguntas" class="section section--surface" aria-labelledby="faq-title">
  <div class="wrap faq">
    <div class="stack faq__head" style="--gap:1.25rem" data-reveal>
      <p class="label">{q.label}</p>
      <h2 id="faq-title" class="h2">{q.titleA} <em>{q.titleEm}</em></h2>
      <p class="lead">{q.intro}</p>
      <p><a class="btn btn--ghost" href={wa} target="_blank" rel="noopener" data-wa>{q.cta}</a></p>
    </div>
    <div class="faq__list">
      {q.items.map(([question, answer], i) => (
        <details class="qa" open={i === 0}>
          <summary><span>{question}</span><span class="qa__icon" aria-hidden="true"></span></summary>
          <p class="muted">{answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { display: grid; grid-template-columns: 25rem 1fr; gap: clamp(2rem, 7vw, 6rem); }
  .qa { border-bottom: 1px solid var(--line); }
  .qa summary {
    list-style: none; display: flex; justify-content: space-between; gap: 1.5rem; align-items: center;
    padding: 1.375rem 0; cursor: pointer; font-weight: 600; font-size: 1.1875rem; line-height: 1.3;
  }
  .qa summary::-webkit-details-marker { display: none; }
  .qa summary > span:first-child { transition: color 0.3s, transform 0.5s var(--ease-out); }
  .qa summary:hover > span:first-child { color: var(--accent); transform: translateX(0.25rem); }
  .qa::details-content { block-size: 0; overflow-y: clip; transition: block-size 0.5s var(--ease-out), content-visibility 0.5s allow-discrete; }
  .qa[open]::details-content { block-size: auto; }
  .qa__icon { position: relative; width: 1rem; height: 1rem; flex-shrink: 0; }
  .qa__icon { transition: transform 0.5s var(--ease-out); }
  .qa__icon::before, .qa__icon::after { content: ''; position: absolute; inset: 50% 0 auto; height: 1.5px; background: var(--accent); transition: transform 0.4s var(--ease-out); }
  .qa__icon::after { transform: rotate(90deg); }
  .qa[open] .qa__icon { transform: rotate(180deg); }
  .qa[open] .qa__icon::after { transform: rotate(0deg); }
  .qa p { padding-bottom: 1.375rem; max-width: 62ch; }
  @media (max-width: 860px) {
    .faq { grid-template-columns: 1fr; }
    .qa summary { font-size: 1.0625rem; padding: 1.125rem 0; }
  }
</style>
