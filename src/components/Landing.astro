---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Welcome from './Welcome.astro';
import House from './House.astro';
import Gallery from './Gallery.astro';
import Availability from './Availability.astro';
import Direct from './Direct.astro';
import Reviews from './Reviews.astro';
import Faq from './Faq.astro';
import Around from './Around.astro';
import Contact from './Contact.astro';
import FinalCta from './FinalCta.astro';
import Footer from './Footer.astro';
import StickyBar from './StickyBar.astro';
import Tour from './Tour.astro';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
---

<Base lang={lang}>
  <Header lang={lang} />
  <main id="contenido" tabindex="-1">
    <Hero lang={lang} />
    <Welcome lang={lang} />
    <House lang={lang} />
    <Gallery lang={lang} />
    <Availability lang={lang} />
    <Direct lang={lang} />
    <Reviews lang={lang} />
    <Faq lang={lang} />
    <Around lang={lang} />
    <Contact lang={lang} />
    <FinalCta lang={lang} />
  </main>
  <Footer lang={lang} />
  <StickyBar lang={lang} />
  <Tour lang={lang} />
</Base>
