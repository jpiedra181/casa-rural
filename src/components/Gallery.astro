---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { useT, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const t = useT(Astro.props.lang);
const heights = [440, 540, 400, 500];
---

<section id="por-dentro" class="section section--surface" aria-labelledby="gallery-title">
  <div class="wrap">
    <div class="gallery__head">
      <div class="stack" style="--gap:1.5rem" data-reveal>
        <p class="label">{t.gallery.label}</p>
        <h2 id="gallery-title" class="h2">{t.gallery.titleA}<br /><em>{t.gallery.titleEm}</em></h2>
      </div>
      <div class="stack gallery__intro" style="--gap:1.5rem;--i:1" data-reveal>
        <p class="lead">{t.gallery.intro}</p>
        <p><button class="btn btn--ghost" type="button" data-tour-open aria-haspopup="dialog" aria-describedby="tour-note"><Icon name="360" size={20} class="btn__icon btn__icon--spin" />{t.gallery.tour}</button></p>
        <p id="tour-note" class="muted small">{t.gallery.tourNote}</p>
      </div>
    </div>

    <div class="arches-scroll" role="region" aria-label={t.gallery.label.replace(/^\d+\s—\s/, '')} tabindex="0" aria-describedby="swipe-hint">
    <ul role="list" class="arches">
      {t.gallery.items.map((it, i) => (
        <li class="arches__item" style={`--h:${heights[i] / 16}rem;--i:${i}`} data-reveal>
          <figure>
            <Photo name={it.img} alt={it.alt} variant="arch" sizes="(max-width: 860px) 240px, 405px" widths={[300, 480, 600, 800]} pendingLabel={t.photoPending} live />
            <figcaption class="serif">{it.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
    </div>
    <p id="swipe-hint" class="swipe muted">{t.gallery.swipe} →</p>

    <div class="wide" data-reveal>
      <Photo name="porche" alt={t.gallery.wideAlt} variant="card" sizes="(max-width: 860px) 135vw, (max-width: 1280px) 92vw, 1200px" widths={[640, 960, 1200, 1600, 2400]} class="gallery__wide" pendingLabel={t.photoPending} live />
      <button class="pano-cta" type="button" data-tour-open aria-haspopup="dialog">
        <span class="pano-cta__orb serif" aria-hidden="true">360°</span>
        <span class="pano-cta__text">
          <strong class="serif">{t.gallery.tourCta}</strong>
          <span>{t.gallery.tourCtaSub}</span>
        </span>
      </button>
    </div>
  </div>
</section>

<style>
  .gallery__head { display: grid; grid-template-columns: 1fr 26.25rem; gap: clamp(1.5rem, 6vw, 6rem); align-items: end; margin-bottom: 4rem; }
  .small { font-size: 0.875rem; }
  .arches { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; align-items: end; }
  .arches :global(.photo) { height: var(--h); }
  .arches figcaption { text-align: center; font-style: italic; font-size: 1.375rem; margin-top: 0.875rem; transition: color 0.4s, transform 0.6s var(--ease-out); }
  .arches figure:hover figcaption { color: var(--accent); transform: translateY(-3px); }
  .swipe { display: none; font-size: 0.8125rem; font-weight: 500; margin-top: 1rem; }

  /* Foto ancha + llamada al tour 360° */
  .wide { position: relative; margin-top: 4rem; }
  .wide :global(.gallery__wide) { aspect-ratio: 1200 / 520; }
  .wide :global(.gallery__wide)::before {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: radial-gradient(60% 70% at 50% 55%, rgb(14 11 9 / 0.45), transparent 75%);
  }
  .pano-cta {
    position: absolute; inset: 50% auto auto 50%; z-index: 2;
    transform: translate(-50%, -50%);
    display: flex; align-items: center; gap: 1.125rem;
    padding: 0.75rem 1.875rem 0.75rem 0.75rem; border-radius: var(--pill);
    background: rgb(21 17 14 / 0.55);
    -webkit-backdrop-filter: blur(0.625rem) saturate(1.3);
    backdrop-filter: blur(0.625rem) saturate(1.3);
    border: 1px solid rgb(var(--gold) / 0.3);
    color: var(--text); text-align: left; cursor: pointer;
    box-shadow: 0 1.25rem 3.125rem rgb(0 0 0 / 0.4);
    transition: transform 0.6s var(--ease-out), background-color 0.4s, border-color 0.4s;
  }
  .pano-cta__orb {
    position: relative; display: grid; place-items: center;
    width: 4rem; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle at 34% 28%, #ffe0b4 0%, #f8ae6a 30%, var(--primary) 60%, #a94c1b 100%);
    color: #2a1407; font-size: 1.375rem; letter-spacing: -0.02em;
    box-shadow: 0 0 1.875rem rgb(var(--ember) / 0.6);
    transition: transform 0.6s var(--ease-out);
  }
  .pano-cta__orb::before, .pano-cta__orb::after {
    content: ''; position: absolute; inset: 0; border-radius: 50%;
    border: 1.5px solid rgb(var(--ember) / 0.8);
    animation: ripple 2.6s var(--ease-out) infinite;
  }
  .pano-cta__orb::after { animation-delay: 1.3s; }
  .pano-cta__text { display: grid; gap: 2px; }
  .pano-cta__text strong { font-weight: 400; font-size: 1.75rem; line-height: 1; }
  .pano-cta__text span { font-size: 0.8125rem; color: var(--muted); }
  .pano-cta:is(:hover, :focus-visible) { transform: translate(-50%, -50%) scale(1.04); background: rgb(21 17 14 / 0.72); border-color: rgb(var(--gold) / 0.55); }
  .pano-cta:is(:hover, :focus-visible) .pano-cta__orb { transform: scale(1.08); }
  .pano-cta:focus-visible { outline-offset: 0.25rem; border-radius: var(--pill); }
  @keyframes ripple {
    0% { transform: scale(1); opacity: 0.9; }
    100% { transform: scale(1.9); opacity: 0; }
  }

  @media (max-width: 860px) {
    .gallery__head { grid-template-columns: 1fr; margin-bottom: 2rem; }
    .arches-scroll { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scroll-padding-inline: var(--gutter); }
    .arches-scroll::-webkit-scrollbar { display: none; }
    .arches {
      display: flex; gap: 0.75rem; width: max-content;
    }
    .arches__item { flex: 0 0 15rem; scroll-snap-align: start; }
    .arches :global(.photo) { height: 20rem; }
    .arches figcaption { text-align: left; font-style: normal; font-size: 1.25rem; }
    .swipe { display: block; }
    .wide { margin-top: 2rem; }
    .wide :global(.gallery__wide) { aspect-ratio: 350 / 220; }
    .pano-cta { gap: 0.75rem; padding: 0.5rem 1.25rem 0.5rem 0.5rem; }
    .pano-cta__orb { width: 2.875rem; font-size: 1rem; }
    .pano-cta__text strong { font-size: 1.25rem; white-space: nowrap; }
    .pano-cta__text span { display: none; }
  }
</style>
