---
import { useT, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const altPath = lang === 'es' ? '/en/' : '/';
const links = [
  ['#la-casa', t.nav.house],
  ['#disponibilidad', t.nav.availability],
  ['#opiniones', t.nav.reviews],
  ['#preguntas', t.nav.faq],
  ['#como-llegar', t.nav.location],
];
---

<aside class="demo" aria-label="Demo"><p>{t.demo}</p></aside>
<header class="header">
  <div class="header__inner wrap">
    <a class="logo" href={lang === 'es' ? '/' : '/en/'}>
      <span class="logo__name serif">La Casa <em>del Pinar</em></span>
      <span class="logo__tag">{t.nav.tagline}</span>
    </a>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-open={t.nav.menu} data-close={t.nav.close}>
      <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true" focusable="false"><path d="M4 9h20M4 14h20M4 19h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"></path></svg>
      <span class="visually-hidden">{t.nav.menu}</span>
    </button>

    <nav id="menu" class="nav" aria-label={t.nav.label}>
      <ul role="list" class="nav__list">
        {links.map(([href, label]) => <li><a class="u-line" href={href}>{label}</a></li>)}
      </ul>
      <div class="nav__actions">
        <a class="lang" href={altPath} hreflang={lang === 'es' ? 'en' : 'es'} lang={lang === 'es' ? 'en' : 'es'} aria-label={t.nav.langSwitchLabel}>{t.nav.langSwitch}</a>
        <a class="btn btn--primary" href="#disponibilidad">{t.nav.book}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.getElementById('menu');
  if (btn && nav) {
    const label = btn.querySelector('.visually-hidden')!;
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
      label.textContent = open ? btn.dataset.close! : btn.dataset.open!;
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { set(false); btn.focus(); }
    });
  }
</script>

<style>
  .demo {
    background: var(--dark);
    color: var(--muted);
    text-align: center;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.5rem 1.25rem;
  }
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(21 17 14 / 0.88);
    backdrop-filter: blur(0.625rem);
    border-bottom: 1px solid var(--line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1rem;
  }
  .logo { text-decoration: none; display: grid; gap: 2px; white-space: nowrap; }
  .logo__name { font-size: 1.625rem; line-height: 1; }
  .logo__name em { color: var(--accent); }
  .logo__tag { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .nav { display: flex; align-items: center; gap: 2.25rem; }
  .nav__list { display: flex; gap: 2rem; }
  .nav__list a { text-decoration: none; font-weight: 500; font-size: 0.9375rem; white-space: nowrap; }
  .nav__actions { display: flex; align-items: center; gap: 1.25rem; }
  .lang { font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.06em; color: var(--muted); text-underline-offset: 0.25rem; transition: color 0.3s; }
  .lang:hover { color: var(--accent); }
  .nav .btn { min-height: 2.75rem; padding: 0.625rem 1.375rem; white-space: nowrap; }
  .menu-btn { display: none; background: none; border: 0; padding: 0.5rem; margin-right: -0.5rem; cursor: pointer; color: var(--text); }

  /* Portátiles pequeños: menú más apretado para que quepa en una línea */
  @media (max-width: 1240px) {
    .nav { gap: 1.5rem; }
    .nav__list { gap: 1.375rem; }
    .nav__actions { gap: 1rem; }
  }

  /* Hasta 1080 px (tablets en horizontal incluidas): menú desplegable */
  @media (max-width: 1080px) {
    .menu-btn { display: inline-flex; }
    .nav {
      display: none;
      position: absolute;
      inset: 100% 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
      padding: 1.5rem var(--gutter) 2rem;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      max-height: calc(100dvh - 100%);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .nav.is-open { display: flex; }
    .nav__list { flex-direction: column; gap: 0.25rem; }
    .nav__list a { display: block; padding: 0.625rem 0; font-size: 1.125rem; }
    .nav__actions { justify-content: space-between; }
  }

  /* Móviles en horizontal: cabecera compacta para no comerse la pantalla */
  @media (max-height: 520px) and (orientation: landscape) {
    .demo { padding-block: 0.3125rem; }
    .header__inner { padding-block: 0.5rem; }
    .logo__name { font-size: 1.375rem; }
    .logo__tag { display: none; }
    .nav__list a { padding: 0.5rem 0; }
  }
</style>
