---
import { useT, type Lang } from '../i18n/ui';
import { site } from '../data/site';
interface Props { lang: Lang }
const t = useT(Astro.props.lang);
const r = t.reviews;
---

<section id="opiniones" class="section reviews" aria-labelledby="reviews-label">
  <div class="wrap">
    <h2 id="reviews-label" class="label">{r.label}</h2>
    <figure class="featured" data-reveal>
      <p class="stars" role="img" aria-label={r.stars}>{'★★★★★'}</p>
      <blockquote class="quote serif featured__quote"><p>{r.featuredA}<em>{r.featuredEm}</em>{r.featuredB}</p></blockquote>
      <figcaption class="muted">{r.featuredAuthor}</figcaption>
    </figure>
    <ul role="list" class="cards">
      {r.items.map(([text, name, detail], i) => (
        <li class="card-review" data-reveal style={`--i:${i + 1}`}>
          <figure>
            <p class="stars stars--sm" role="img" aria-label={r.stars}>{'★★★★★'}</p>
            <blockquote><p>{text}</p></blockquote>
            <figcaption><strong>{name}</strong><span class="muted">{detail}</span></figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <p class="more"><a class="link-accent" href={site.reviewsUrl} target="_blank" rel="noopener">{r.more} <span aria-hidden="true">→</span></a></p>
  </div>
</section>

<style>
  .reviews .wrap { display: grid; justify-items: center; text-align: center; }
  .featured { display: grid; gap: 1.5rem; justify-items: center; margin-top: 2rem; max-width: 65rem; }
  .stars { color: var(--accent); letter-spacing: 0.2em; font-size: 1.25rem; font-family: var(--sans); }
  .stars--sm { font-size: 1rem; }
  .featured__quote { font-size: clamp(1.875rem, 1.3rem + 2vw, 3.25rem); line-height: 1.12; }
  .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; width: 100%; margin-top: 3.5rem; text-align: left; }
  .card-review {
    background: var(--surface); border-radius: var(--radius); padding: 2rem;
    border: 1px solid transparent;
    transition: transform 0.6s var(--ease-out), border-color 0.4s, box-shadow 0.6s, opacity 0.9s var(--ease-out);
  }
  .card-review.is-in:hover { transform: translateY(-4px); border-color: rgb(var(--ember) / 0.35); box-shadow: 0 1.125rem 3.125rem rgb(0 0 0 / 0.35), 0 0 2.5rem rgb(var(--ember) / 0.1); }
  .card-review figure { display: grid; gap: 1rem; }
  .card-review blockquote { font-size: 1.0625rem; line-height: 1.55; }
  .card-review figcaption { display: grid; gap: 2px; font-size: 0.9375rem; }
  .more { margin-top: 2rem; font-size: 0.9375rem; }
  @media (max-width: 860px) {
    .cards { grid-template-columns: 1fr; margin-top: 2rem; }
    .card-review { padding: 1.5rem; }
  }
</style>
